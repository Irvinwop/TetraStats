# The tracker is preconfigured for this player.
TRACK_USERNAME=Irvinwop
TRACK_PLAYER_ID=678656e79f48dae00cefd822

# Public Tetra Channel record streams to archive.
TRACK_STREAMS=league,40l,blitz,zenith,zenithex
POLL_INTERVAL_MS=300000
BACKFILL_MAX_PAGES=100
PROCESS_BATCH_SIZE=25

# auto uses the official API when TETRIO_TOKEN is supplied, then falls back to
# Inoue. A TETR.IO token is strongly recommended for complete replay backfills.
REPLAY_SOURCE=auto
TETRIO_TOKEN=
MINOMUNCHER_URL=https://minomuncher.com

PORT=8080
TRACKER_HOST=0.0.0.0
DATA_DIR=/app/data
